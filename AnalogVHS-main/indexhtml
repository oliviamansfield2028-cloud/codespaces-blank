<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Opening Game</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0b0b0f;
        color: #f5f5f5;
        font-family: Arial, sans-serif;
      }
      .box {
        text-align: center;
        padding: 24px 32px;
        border: 1px solid #2a2a32;
        border-radius: 12px;
        background: #121218;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
      }
      h1 {
        margin: 0 0 12px;
        font-size: 1.1rem;
      }
      p {
        margin: 0;
        color: #cfcfe3;
      }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>Opening the game...</h1>
      <p>If it does not start, open index.html in this folder.</p>
    </div>

    <script>
      window.location.replace("index.html");
    </script>
  </body>
</html>
